  },
  "keywords": [
    "vue3",
    "keepalive",
    "component",
    "cache",
    "state-preservation"
  ],
  "author": "hnwangzhenwei",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.5.27",
    "@vue/shared": "^3.5.27",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.4.0",
    "vue-tsc": "^3.2.4"
  }
}
