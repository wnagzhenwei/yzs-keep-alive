  "description": "A custom KeepAlive component for Vue 3 that doesn't depend on Vue's built-in KeepAlive",
  "main": "dist/yzs-keep-alive-v3.umd.js",
  "module": "dist/yzs-keep-alive-v3.es.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
